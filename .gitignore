node_modules/
target/
dist/
src-tauri/gen/
.DS_Store
*.log
.env
.env.*
!.env.example
.idea/
.vscode/

# Internal working documents never belong in this repository, which is public.
# Plans, porting notes, audits, reconnaissance and agent reports live one
# directory up, outside the repo. Only user-facing docs ship here: README,
# LICENSE, NOTICE, THIRD_PARTY and the per-module READMEs.
ARCHITETTURA.md
PORTING-*.md
*-REPORT.md
audit-*.md
review-*.md
recon/

# Whole-output captures from gate runs. Every check here is run by redirecting
# its complete output to a file and searching the file afterwards, because a
# summary narrowed while capturing is evidence about the filter, not the run.
# Those captures are scratch and must never reach a public repository.
.gate-*.txt

# Workspace-local Oracle/Augur runtime data (CKG, findings ledger, indexes).
# These are built by running Oracle against this checkout and belong to whoever
# ran it, not to the repository.
oracle-data/*

# The model bundles are the exception: they are third-party weights that the
# repository deliberately ships, and their LICENSE files must ship with them.
# Written as `oracle-data/*` above plus this negation because git cannot
# re-include a path whose parent directory is itself excluded — with a bare
# `oracle-data/` rule the attribution files here are silently dropped from
# every commit.
!oracle-data/models/
