{
  // Merged over tauri.conf.json only by `pnpm build:installer`
  // (tauri build --config). tauri-build validates
  // bundle.resources on every cargo build and fails when a path is missing, so
  // the daemon mapping cannot live in a config every build reads: a checkout
  // that never built the release daemon would not compile.
  // The installer build is also the one build that stages the pinned ConPTY
  // payload and notices, before Tauri validates the resources below.
  // The stage call resets PSModulePath to the Machine value first: whatever
  // parent shell launched this build may leave PowerShell 7's module list in
  // the environment (a local pwsh session does), where Windows PowerShell
  // cannot resolve Get-FileHash. The assignment replaces the parent's value
  // and synthesises no defaults — an empty Machine value fails loudly here.
  // Tauri runs this chain through `cmd /S /C`, so the -Command payload must
  // hold neither double quotes (Rust argv escapes them to \"-pairs, which make
  // PowerShell treat the payload as a string literal instead of code) nor an
  // unquoted `&` (a cmd separator); a bare script path needs no call operator.
  "build": {
    "beforeBuildCommand": "cargo build --release -p devboule-daemon && powershell -NoProfile -ExecutionPolicy Bypass -Command $env:PSModulePath=[Environment]::GetEnvironmentVariable('PSModulePath','Machine'); .\\scripts\\stage-conpty.ps1 -TargetDir target\\release && pnpm build"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    // The GUI spawns the daemon it finds beside its own executable
    // (crates/devboule-daemon/src/spawn.rs:20-36), and on Windows NSIS the
    // resource root IS the install root. An empty target keeps the source file
    // name, so this lands as <install>\devboule-daemon.exe.
    // The loader looks for the ConPTY pair beside that executable and the
    // notices travel with the binaries, so both trees land in the install
    // root next to it, staged by beforeBuildCommand above.
    "resources": {
      "../target/release/devboule-daemon.exe": "",
      "../target/release/conpty/": "conpty/",
      "../target/release/THIRD-PARTY-NOTICES/": "THIRD-PARTY-NOTICES/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        // Per-user NSIS would default to $LOCALAPPDATA\Devboule, which is the
        // daemon's data directory (crates/devboule-daemon/src/paths.rs:21-38):
        // the program files would sit inside data the uninstaller must keep.
        // The pinned template moves only that default.
        "template": "nsis/installer.nsi",
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  }
}
