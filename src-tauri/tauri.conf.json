{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Devboule",
  "version": "0.1.0",
  "identifier": "com.devboule.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        // Explicit: capabilities/default.json grants core:default to the window
        // labelled "main". Tauri only defaults the label to "main" when it is
        // omitted, so leaving it implicit couples IPC to an undeclared default.
        "label": "main",
        "title": "Devboule",
        "width": 1280,
        "height": 800,
        "minWidth": 1280,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:6767 ws://127.0.0.1:6767",
        "font-src": "'self'",
        "img-src": "'self' data:",
        // M5: PixiJS will require 'unsafe-eval' in script-src for its runtime; keep it out until that milestone needs it.
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": false
  }
}
