{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Devboule",
  "version": "0.1.0",
  "identifier": "com.devboule.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cargo build -p devboule-daemon && pnpm dev",
    // The app spawns the daemon and looks for it beside its own executable, so a
    // build that produces only `devboule.exe` produces an app that cannot start
    // one — and says so in a footer sentence nobody can act on. The dev command
    // has always built it; the release command must too, or `target/release`
    // holds half an application. Packaging proper (`bundle.active` is false: the
    // repo has never produced an installer) is a separate decision.
    "beforeBuildCommand": "cargo build --release -p devboule-daemon && pnpm build"
  },
  "app": {
    "windows": [
      {
        // Explicit: capabilities/default.json grants core:default to the window
        // labelled "main". Tauri only defaults the label to "main" when it is
        // omitted, so leaving it implicit couples IPC to an undeclared default.
        "label": "main",
        "title": "Devboule",
        "width": 1280,
        "height": 800,
        "minWidth": 1280,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": true,
        // Tauri replaces WebView2's drag-drop handler on Windows and defaults
        // this to true, which swallows the DOM drag events entirely: dropping a
        // file on the Design composer fires no dragenter, dragover, or drop.
        // Turning it off hands HTML5 drag and drop back to the page, which is
        // where the import intake reads the bytes. The Tauri-side alternative
        // (onDragDropEvent) delivers paths rather than bytes, so it would need
        // filesystem permissions this app does not grant.
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        // base-uri and form-action do NOT fall back to default-src; absent
        // means unprotected. A document could rewrite every relative URL with
        // <base href>, and nothing here submits forms anywhere but 'self'.
        // Free hardening, flagged by the Design session's artifact audit.
        "base-uri": "'self'",
        "form-action": "'self'",
        // `http://plugin.localhost` is the origin our own registered scheme gets
        // on Windows (src/plugin_assets.rs). A plugin's UI is served by us, from
        // a directory we resolved, but it is a DIFFERENT origin than the app, so
        // 'self' does not cover it. This is a real widening and a narrow one: no
        // string becomes executable, unlike 'unsafe-eval'.
        "connect-src": "'self' ipc: http://ipc.localhost http://plugin.localhost ws://localhost:6767 ws://127.0.0.1:6767",
        "font-src": "'self'",
        // `asset:` (macOS/Linux) and `http://asset.localhost` (Windows,
        // where the custom scheme becomes an HTTP origin) are the Files
        // panel's staged previews: the `<img>`/`<video>`/`<embed>` below
        // loads one copy from the daemon's `previews` folder through
        // Tauri's asset protocol. img-src for the image, media-src for the
        // video, object-src for the PDF `<embed>` — the last two are new
        // keys, because media and object do NOT fall back to `default-src`
        // for this purpose in any way that would admit them: absent, they
        // deny. The scope of what may be read is separate and narrower
        // (`assetProtocol.scope` below); this line only lets the origin
        // speak at all.
        "img-src": "'self' data: http://plugin.localhost asset: http://asset.localhost",
        "media-src": "asset: http://asset.localhost",
        "object-src": "asset: http://asset.localhost",
        // Still no 'unsafe-eval', and M5 does not need it, contrary to what this
        // comment used to say. PixiJS compiles shader glue with `new Function`,
        // but it ships `pixi.js/unsafe-eval` — a patch whose npm description is
        // "adds support for environments that disallow support of new Function".
        // Polis already imports it (old-devboule createPolis.ts:18) under its own
        // comment saying not to open the CSP. Verified 2026-08-30.
        //
        // The plugin origin is listed because a plugin's UI module is served by
        // us on a separate origin; see connect-src above. Listing one local
        // origin we serve is not the same kind of change as allowing eval.
        "script-src": "'self' http://plugin.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:"
      },
      // The Files panel's full-size preview: the webview fetches staged
      // copies through Tauri's asset protocol instead of base64 through the
      // wire, so the 128 KiB frame cap stops being the display limit. The
      // scope is ONE directory — the daemon's `<runtime dir>/previews`
      // folder — and never the workspace: `$CACHE` resolves to
      // `%LOCALAPPDATA%` (no identifier), which is exactly where
      // `RuntimePaths::from_env` puts `Devboule` — while `$APPLOCALDATA`
      // carries `com.devboule.desktop` and would cover a folder nothing
      // writes. The daemon is that folder's only writer, it clears it on
      // every stage and at start, and the panel's unstage deletes the copy
      // — a concession cannot be withdrawn until restart, so deletion is
      // the revoke. `*` is one level (`require_literal_separator`), which
      // is the flat folder the daemon writes; a subfolder would be outside
      // this scope. Verified with bytes in `backend/tests/asset_scope.rs`.
      "assetProtocol": {
        "enable": true,
        "scope": ["$CACHE/Devboule/previews/*"]
      }
    }
  },
  "bundle": {
    "active": false
  }
}
