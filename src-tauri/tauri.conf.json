{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Devboule",
  "version": "0.1.0",
  "identifier": "com.devboule.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        // Explicit: capabilities/default.json grants core:default to the window
        // labelled "main". Tauri only defaults the label to "main" when it is
        // omitted, so leaving it implicit couples IPC to an undeclared default.
        "label": "main",
        "title": "Devboule",
        "width": 1280,
        "height": 800,
        "minWidth": 1280,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:6767 ws://127.0.0.1:6767",
        "font-src": "'self'",
        "img-src": "'self' data:",
        // M5 does NOT need this relaxed, contrary to what this comment used to
        // say. PixiJS compiles shader glue with `new Function`, but it ships
        // `pixi.js/unsafe-eval` — a patch whose npm description is "adds support
        // for environments that disallow support of new Function". Polis already
        // imports it (old-devboule src/components/polis/createPolis.ts:18) with a
        // comment saying not to add 'unsafe-eval' to the CSP. Importing that
        // module is what keeps this directive strict; verified 2026-08-30.
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": false
  }
}
